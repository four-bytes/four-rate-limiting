{
    "name": "four-bytes/four-rate-limiting",
    "description": "PHP 8.4+ rate limiting library for API clients — token bucket, fixed window, sliding window, leaky bucket",
    "keywords": [
        "rate-limiting",
        "rate-limiter",
        "throttling",
        "token-bucket",
        "sliding-window",
        "leaky-bucket",
        "php"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Four Bytes"
        }
    ],
    "support": {
        "issues": "https://github.com/four-bytes/four-rate-limiting/issues",
        "source": "https://github.com/four-bytes/four-rate-limiting"
    },
    "require": {
        "php": "^8.4",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "suggest": {
        "symfony/cache": "PSR-16 implementation for Redis/Memcached/APCu (e.g. symfony/cache)",
        "phpfastcache/phpfastcache": "Alternative PSR-16 implementation",
        "psr/http-message": "For RateLimitMiddleware HTTP integration"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "Four\\RateLimit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Four\\RateLimit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse src tests",
        "cs-check": "phpcs src tests",
        "cs-fix": "phpcbf src tests"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
